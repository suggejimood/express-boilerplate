# Single env file for every app and the local infrastructure.
#   cp .env.example .env
# Values target host-run development (`pnpm dev`: apps on your machine, infra in Docker on
# localhost). infra/docker-compose.yml reuses this file and only swaps hostnames
# (localhost → postgres, redis, minio, lgtm, api) for containers.
# PORT is intentionally absent: each app has its own default (gateway 8080, api 3001,
# generation-worker 3002, notification 3003).

NODE_ENV=development
LOG_LEVEL=debug

# ── Postgres (container + apps) ───────────────────────────────────────────────
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app_db
# Keep in sync with the three values above (env files do not expand variables).
DATABASE_URL=postgres://app:app@localhost:5432/app_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── MinIO / S3 (container + apps) ─────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_ENDPOINT=http://localhost:9000
# Host that clients (mobile app) see in presigned URLs.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=images
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin

# ── Telemetry (grafana/otel-lgtm) ─────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── gateway ───────────────────────────────────────────────────────────────────
API_URL=http://localhost:3001
RATE_LIMIT_POINTS=100
RATE_LIMIT_DURATION_SECONDS=60
# HS256 shared secret for local dev; use a JWKS URL for asymmetric keys in production.
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_ISSUER=express-boilerplate
JWT_AUDIENCE=mobile-app

# ── workers ───────────────────────────────────────────────────────────────────
GENERATION_CONCURRENCY=4
NOTIFICATION_CONCURRENCY=10
