{
  "name": "gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env --import ./src/instrumentation.ts src/server.ts",
    "build": "tsup",
    "start": "node --import ./dist/instrumentation.js dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --exclude '**/*.integration.test.ts' --passWithNoTests",
    "test:integration": "vitest run integration --passWithNoTests"
  },
  "dependencies": {
    "@repo/config": "workspace:*",
    "@repo/logger": "workspace:*",
    "@repo/telemetry": "workspace:*",
    "express": "catalog:",
    "http-proxy-middleware": "^4.2.0",
    "ioredis": "catalog:",
    "jose": "^6.2.12",
    "rate-limiter-flexible": "^11.2.1"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/supertest": "catalog:",
    "supertest": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "vitest": "catalog:"
  }
}
